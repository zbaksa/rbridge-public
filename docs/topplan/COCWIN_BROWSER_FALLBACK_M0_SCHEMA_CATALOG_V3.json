      "CHAT_ROLLOVER_V1",
      "REPLAY_SEQUENCE_V1",
      "CHAT_EFFECT_REQUEST_V1",
      "CHAT_ASSISTANT_TURN_CAPTURE_V2"
    ]
  },
  "x-sharedReasonCodes": [
    "PROTOCOL_MAJOR_MISMATCH",
    "RBRIDGE_CAPABILITY_MISSING",
    "BROWSER_BINDING_STALE",
    "SEND_UNCERTAIN",
    "NO_COMMAND_OBSERVED",
    "AMBIGUOUS_MACHINE_RESPONSE",
    "MALFORMED_MACHINE_RESPONSE",
    "MACHINE_RESPONSE_TOO_LARGE",
    "OUTPUT_BUDGET_EXCEEDED",
    "AGENT_RESPONSE_CORRELATION_MISMATCH",
    "CONTEXT_HANDLE_STALE",
    "CLOUD_EXPORT_BLOCKED",
    "CHANGESET_INVALID",
    "CHANGESET_OPERATION_CONFLICT",
    "VERIFICATION_PROFILE_UNAVAILABLE",
    "VERIFICATION_UNCERTAIN",
    "COMMIT_UNCERTAIN",
    "CANONICAL_MOVED",
    "PROMOTION_UNCERTAIN",
    "PROVIDER_QUOTA_EXHAUSTED",
    "PROVIDER_UNAVAILABLE",
    "STALE_GENERATION",
    "REQUEST_ID_COLLISION",
    "OWNER_ACTION_REQUIRED",
    "EXTERNAL_AGENT_EFFECT_OUTCOME_UNCERTAIN",
    "EXTERNAL_AGENT_RECONCILIATION_UNAVAILABLE",
    "UI_PROTOCOL_CHANGED"
  ],
  "x-semanticConstraints": [
    "Validators, not schema shape alone, recompute Canonical JSON V1 digests excluding only the respective self digest field.",
    "Effect identity is SHA256 UTF8(session NUL generation NUL attempt NUL kind NUL decimal ordinal).",
    "Payload variant must match effectKind; rollover next generation equals current+1 within 2147483647.",
    "Exact project component uses the existing ChatGPT URL parser semantics; arbitrary prefix matching is forbidden.",
    "Request AND command AND result AND complete event serialized JSON UTF8 bytes each fit the negotiated 4096..65536 ceiling including escaping.",
    "Text limits count UTF8 bytes: prompt/result 48000, full assistant turn 16384; no normalization, truncation or selected fence.",
    "Result validates the supplied full command independently and all seven command/request correlations.",
    "VERIFIED requires full matching receipt and reason null. Binding leader/capture and verified SEND leader epochs are positive. Other states require a stable reason and may carry a matching negative SEND receipt.",
    "Rollover receipt matches old request; nested new binding retains exact browser/profile/project/owner, uses successor generation and a different conversation ID.",
    "CAPTURED validates receipt digest, full raw-text count/hash, envelope/receipt correlations and event digest. Capture request/conversation/epoch/peer and stream sequence are additionally checked at ingress.",
    "REJECTED omits text: MACHINE_RESPONSE_TOO_LARGE iff count>16384, otherwise OUTPUT_BUDGET_EXCEEDED. The omitted original text cannot be independently reconstructed from a rejection receipt.",
    "HELLO major 1 is authenticated and pinned before constructing VerifiedPeerV3; minor>=1 and all ten capabilities are required for V3. No implicit downgrade.",
    "Plain JSON data is snapshotted before asynchronous digests; unknown/missing keys, accessors, symbols and non-data prototypes are rejected.",
    "Legacy V1 readers retain their meanings and cannot authorize the V3 parser lane. No runtime capability is advertised by this contract-only work."
  ],
  "oneOf": [
    {
      "$ref": "#/$defs/CocwinRbridgeEffectRequestV1"
    },
    {
      "$ref": "#/$defs/RbridgeChatEffectCommandV1"
    },
    {
      "$ref": "#/$defs/RbridgeChatEffectResultV1"
    },
    {
      "$ref": "#/$defs/RbridgeChatEventV1"
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "minLength": 40,
      "maxLength": 40
    },
    "sessionId": {
      "type": "string",
      "pattern": "^exta-[0-9a-f]{32}$",
      "minLength": 37,
      "maxLength": 37
    },
    "generation": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "minLength": 36,
      "maxLength": 36
    },
    "attemptId": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "[\\u0000-\\u001f\\u007f]"
      },
      "maxLength": 256,
      "x-maxUtf8Bytes": 256,
      "pattern": "^exta-[0-9a-f]{32}:a:[1-9][0-9]*$",
      "x-validation": "suffix is a canonical positive safe integer and session prefix must match"
    },
    "timestamp": {
      "type": "string",
      "minLength": 1,
      "x-validation": "Date.parse finite and new Date(ms).toISOString() equals input"
    },
    "reason": {
      "type": "string",
