  "x-protocol": {
    "major": 1,
    "minor": 1,
    "minMessageBytes": 4096,
    "maxMessageBytes": 65536,
    "requiredCapabilities": [
      "CHAT_TARGET_DISCOVERY_V1",
      "CHAT_BINDING_V1",
      "CHAT_WRITE_LEADER_V1",
      "CHAT_CAPTURE_V1",
