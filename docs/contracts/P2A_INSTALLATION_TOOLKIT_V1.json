{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "RBRIDGE_INSTALLATION_TOOLKIT_V1",
  "$ref": "#/$defs/Profile",
  "$defs": {
    "Binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uid",
        "gid",
        "supplementary_gids",
        "account",
        "home",
        "principal_id",
        "target_instance_id",
        "repository",
        "author",
        "mcp_subject",
        "github_subject",
        "policy_sha256"
      ],
      "properties": {
        "uid": {
          "type": "integer",
          "const": 1027
        },
        "gid": {
          "type": "integer",
          "const": 1027
        },
        "supplementary_gids": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "maxItems": 128
        },
        "account": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "home": {
          "type": "string",
          "pattern": "^/[^\\x00\\r\\n]*$"
        },
        "principal_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
        },
        "target_instance_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "author": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}$"
        },
        "mcp_subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "github_subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "policy_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "RuntimePins": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_sha",
        "tree_sha",
        "old_sha",
        "node_path",
        "node_version",
        "node_sha256",
        "npm_cli_path",
        "npm_sha256",
        "lock_sha256",
        "manifest_sha256"
      ],
      "properties": {
        "source_sha": {
          "type": "string",
          "const": "b5881fd8367b4249e82683f1f884f2392cb696d4"
        },
        "tree_sha": {
          "type": "string",
          "const": "8eeabd5628c8226bd42c00d79e2f3c37ad252ba8"
        },
        "old_sha": {
          "type": "string",
          "const": "008885e07394f20746f034cbd7fe52c6b520533d"
        },
        "node_path": {
          "type": "string",
          "pattern": "^/[^\\x00\\r\\n]*$"
        },
        "node_version": {
          "type": "string",
          "const": "22.23.2"
        },
        "node_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "npm_cli_path": {
          "type": "string",
          "pattern": "^/[^\\x00\\r\\n]*$"
        },
        "npm_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "lock_sha256": {
          "type": "string",
          "const": "53c56e80378408dae8e920118d3731de78c22e8e8be7a89cf4a1717f30369c15"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "ToolkitPins": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_sha",
        "manifest_sha256",
        "python_path",
        "python_version",
        "python_sha256",
        "tree_sha"
      ],
      "properties": {
        "source_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "python_path": {
          "type": "string",
          "pattern": "^/[^\\x00\\r\\n]*$"
        },
        "python_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "python_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "tree_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "ToolPin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "path",
        "sha256",
        "version"
      ],
      "properties": {
        "role": {
          "enum": [
            "systemctl",
            "gh",
            "runuser"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^/[^\\x00\\r\\n]*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "InstallPaths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_root",
        "release_parent",
        "current_link",
        "ledger_parent",
        "lock_path",
        "binding_env",
        "binding_dropin",
        "canary_path"
      ],
      "properties": {
        "state_root": {
          "type": "string",
          "pattern": "^/[^\\x00\\r\\n]*$"
        },
        "release_parent": {
          "type": "string",
          "pattern": "^/[^\\x00\\r\\n]*$"
        },
        "current_link": {
          "type": "string",
          "pattern": "^/[^\\x00\\r\\n]*$"
        },
        "ledger_parent": {
          "type": "string",
          "pattern": "^/[^\\x00\\r\\n]*$"
        },
        "lock_path": {
          "type": "string",
          "pattern": "^/[^\\x00\\r\\n]*$"
        },
        "binding_env": {
          "type": "string",
          "pattern": "^/[^\\x00\\r\\n]*$"
        },
        "binding_dropin": {
          "type": "string",
          "pattern": "^/[^\\x00\\r\\n]*$"
        },
        "canary_path": {
          "type": "string",
          "pattern": "^/[^\\x00\\r\\n]*$"
        }
      }
    },
    "PathDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/[^\\x00\\r\\n]*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "ServicePin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "alternate_units",
        "identity_sha256",
        "environment_files",
        "dropins_sha256",
        "canary_sha256"
      ],
      "properties": {
        "unit": {
          "type": "string",
          "const": "rbridge.service"
        },
        "alternate_units": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.@-]+\\.service$"
          },
          "maxItems": 16
        },
        "identity_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "environment_files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PathDigest"
          },
          "maxItems": 32
        },
        "dropins_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "canary_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "Budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_entries",
        "state_depth",
        "state_bytes",
        "artifact_entries",
        "artifact_depth",
        "artifact_bytes",
        "record_bytes",
        "process_log_bytes",
        "process_frames",
        "carrier_bytes",
        "carrier_comments",
        "comment_bytes",
        "carrier_object_bytes",
        "scan_ms",
        "lookup_ms",
        "lookup_batch",
        "lookup_response_bytes",
        "lookup_overall_ms",
        "stop_ms",
        "acceptance_ms",
        "canary_ttl_ms",
        "poll_ms",
        "maintenance_ms"
      ],
      "properties": {
        "state_entries": {
          "type": "integer",
          "const": 40000
        },
        "state_depth": {
          "type": "integer",
          "const": 64
        },
        "state_bytes": {
          "type": "integer",
          "const": 68719476736
        },
        "artifact_entries": {
          "type": "integer",
          "const": 100000
        },
        "artifact_depth": {
          "type": "integer",
          "const": 128
        },
        "artifact_bytes": {
          "type": "integer",
          "const": 1073741824
        },
        "record_bytes": {
          "type": "integer",
          "const": 2097152
        },
        "process_log_bytes": {
          "type": "integer",
          "const": 67108864
        },
        "process_frames": {
          "type": "integer",
          "const": 1048576
        },
        "carrier_bytes": {
          "type": "integer",
          "const": 67108864
        },
        "carrier_comments": {
          "type": "integer",
          "const": 4096
        },
        "comment_bytes": {
          "type": "integer",
          "const": 65536
        },
        "carrier_object_bytes": {
          "type": "integer",
          "const": 8519680
        },
        "scan_ms": {
          "type": "integer",
          "const": 600000
        },
        "lookup_ms": {
          "type": "integer",
          "const": 15000
        },
        "lookup_batch": {
          "type": "integer",
          "const": 25
        },
        "lookup_response_bytes": {
          "type": "integer",
          "const": 2097152
        },
        "lookup_overall_ms": {
          "type": "integer",
          "const": 600000
        },
        "stop_ms": {
          "type": "integer",
          "const": 30000
        },
        "acceptance_ms": {
          "type": "integer",
          "const": 180000
        },
        "canary_ttl_ms": {
          "type": "integer",
          "const": 120000
        },
        "poll_ms": {
          "type": "integer",
          "const": 1000
        },
        "maintenance_ms": {
          "type": "integer",
          "const": 1200000
        }
      }
    },
    "ReaderRegistration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reader_id",
        "source_sha256",
        "entrypoint",
        "version",
        "transport",
        "trusted_context_sha256",
        "qualification_sha256",
        "adoption_sha256"
      ],
      "properties": {
        "reader_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "entrypoint": {
          "type": "string",
          "pattern": "^/[^\\x00\\r\\n]*$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "transport": {
          "enum": [
            "GITHUB",
            "MCP"
          ]
        },
        "trusted_context_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "qualification_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "adoption_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "Profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "binding",
        "runtime",
        "toolkit",
        "paths",
        "service",
        "budget",
        "tools",
        "readers"
      ],
      "properties": {
        "schema": {
          "const": "RBRIDGE_P2A_INSTALL_PROFILE_V1"
        },
        "binding": {
          "$ref": "#/$defs/Binding"
        },
        "runtime": {
          "$ref": "#/$defs/RuntimePins"
        },
        "toolkit": {
          "$ref": "#/$defs/ToolkitPins"
        },
        "paths": {
          "$ref": "#/$defs/InstallPaths"
        },
        "service": {
          "$ref": "#/$defs/ServicePin"
        },
        "budget": {
          "$ref": "#/$defs/Budget"
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ToolPin"
          },
          "maxItems": 3
        },
        "readers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReaderRegistration"
          },
          "maxItems": 64
        }
      }
    },
    "SnapshotToken": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transaction_id",
        "state_root_identity_sha256",
        "tree_sha256",
        "entries",
        "bytes",
        "pause_sha256",
        "captured_at"
      ],
      "properties": {
        "transaction_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "state_root_identity_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "tree_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "entries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "pause_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "captured_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "Check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "status": {
          "enum": [
            "PASS",
            "BLOCKED",
            "UNKNOWN",
            "FAIL"
          ]
        },
        "evidence_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "GateReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate",
        "status",
        "snapshot_sha256",
        "evidence_sha256",
        "checks",
        "reason_codes"
      ],
      "properties": {
        "gate": {
          "enum": [
            "LEGACY",
            "FLOWPILOT",
            "PROCESS",
            "TRANSFERS",
            "CORE"
          ]
        },
        "status": {
          "enum": [
            "PASS",
            "BLOCKED",
            "UNKNOWN",
            "FAIL"
          ]
        },
        "snapshot_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "evidence_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Check"
          },
          "maxItems": 100000
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "maxItems": 100000
        }
      }
    },
    "GateBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "status",
        "reason_codes",
        "token",
        "reports"
      ],
      "properties": {
        "schema": {
          "const": "RBRIDGE_INSTALL_GATE_V1"
        },
        "status": {
          "enum": [
            "PASS",
            "BLOCKED",
            "UNKNOWN",
            "FAIL"
          ]
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "maxItems": 100000
        },
        "token": {
          "$ref": "#/$defs/SnapshotToken"
        },
        "reports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GateReport"
          },
          "maxItems": 5
        }
      }
    },
    "TransactionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "exit_code",
        "phase",
        "ledger_sha256",
        "reason_codes"
      ],
      "properties": {
        "status": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "exit_code": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "phase": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "ledger_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "maxItems": 100000
        }
      }
    },
    "ArtifactEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "size",
        "mode",
        "sha256",
        "target"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[^/][^\\x00\\r\\n]*$",
          "maxLength": 4096
        },
        "kind": {
          "enum": [
            "FILE",
            "DIRECTORY",
            "SYMLINK"
          ]
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "maxLength": 4096
        },
        "target": {
          "type": "string",
          "maxLength": 4096
        }
      }
    },
    "ArtifactManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "kind",
        "source_sha",
        "tree_sha",
        "node_sha256",
        "uid_policy",
        "entries",
        "sha256"
      ],
      "properties": {
        "schema": {
          "enum": [
            "RBRIDGE_INSTALL_ARTIFACT_V1",
            "RBRIDGE_INSTALL_TOOLKIT_V1"
          ]
        },
        "kind": {
          "enum": [
            "RUNTIME",
            "TOOLKIT"
          ]
        },
        "source_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tree_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "node_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "uid_policy": {
          "const": "ROOT_IMMUTABLE_RUNTIME_READABLE"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ArtifactEntry"
          },
          "maxItems": 100000
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "ArtifactProof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_sha256",
        "observed_sha256",
        "source_sha",
        "node_sha256",
        "status",
        "scope"
      ],
      "properties": {
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "observed_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "node_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN",
            "BLOCKED"
          ]
        },
        "scope": {
          "const": "BYTES_INVENTORY_ONLY"
        }
      }
    },
    "ProcessObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "session_id",
        "pid",
        "start_ticks",
        "cgroup",
        "cgroup_settled",
        "settled",
        "process_state",
        "identity_sha256",
        "snapshot_sha256",
        "profile_sha256",
        "observed_at",
        "unit_sha256",
        "observed_identity_sha256"
      ],
      "properties": {
        "scope": {
          "enum": [
            "FIXTURE_AUTHORITY_ONLY",
            "QUALIFIED_HOST_PROCESS"
          ]
        },
        "session_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "pid": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "start_ticks": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,31})$"
        },
        "cgroup": {
          "type": "string",
          "maxLength": 4096
        },
        "cgroup_settled": {
          "enum": [
            true,
            false
          ]
        },
        "settled": {
          "enum": [
            true,
            false
          ]
        },
        "process_state": {
          "enum": [
            "ABSENT",
            "MATCHING",
            "REUSED",
            "UNCLASSIFIED"
          ]
        },
        "identity_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "snapshot_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "profile_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "observed_at": {
          "type": "string",
          "maxLength": 64
        },
        "unit_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "observed_identity_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "IssueEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "state",
        "title",
        "body",
        "author",
        "url",
        "isPullRequest",
        "updatedAt",
        "capture_sha256"
      ],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "state": {
          "enum": [
            "OPEN",
            "CLOSED"
          ]
        },
        "title": {
          "type": "string",
          "maxLength": 1024
        },
        "body": {
          "type": "string",
          "maxLength": 65536
        },
        "author": {
          "type": "string",
          "maxLength": 256
        },
        "url": {
          "type": "string",
          "maxLength": 4096
        },
        "isPullRequest": {
          "enum": [
            true,
            false
          ]
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 64
        },
        "capture_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "LookupCapture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "status",
        "viewer",
        "repository",
        "profile_sha256",
        "snapshot_sha256",
        "capture_sha256"
      ],
      "properties": {
        "scope": {
          "enum": [
            "FIXTURE_AUTHORITY_ONLY",
            "QUALIFIED_GITHUB_READ"
          ]
        },
        "status": {
          "enum": [
            "PASS",
            "BLOCKED",
            "UNKNOWN",
            "FAIL"
          ]
        },
        "viewer": {
          "type": "string",
          "maxLength": 256
        },
        "repository": {
          "type": "string",
          "maxLength": 512
        },
        "profile_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "snapshot_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "capture_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "HelperReady": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "pid",
        "nonce"
      ],
      "properties": {
        "schema": {
          "const": "RBRIDGE_INSTALL_HELPER_READY_V1"
        },
        "pid": {
          "type": "integer",
          "minimum": 2,
          "maximum": 2147483647
        },
        "nonce": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "ProcessProbeTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "pid",
        "start_ticks",
        "identity_sha256"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "pid": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "start_ticks": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,31})$"
        },
        "identity_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "DiscoveryInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "profile",
        "token"
      ],
      "properties": {
        "schema": {
          "const": "RBRIDGE_INSTALL_DISCOVERY_INPUT_V1"
        },
        "profile": {
          "$ref": "#/$defs/Profile"
        },
        "token": {
          "$ref": "#/$defs/SnapshotToken"
        }
      }
    },
    "AuditInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "profile",
        "token",
        "issues",
        "lookup",
        "observations"
      ],
      "properties": {
        "schema": {
          "const": "RBRIDGE_INSTALL_AUDIT_INPUT_V1"
        },
        "profile": {
          "$ref": "#/$defs/Profile"
        },
        "token": {
          "$ref": "#/$defs/SnapshotToken"
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/IssueEvidence"
          },
          "maxItems": 40000
        },
        "lookup": {
          "$ref": "#/$defs/LookupCapture"
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProcessObservation"
          },
          "maxItems": 40000
        }
      }
    },
    "DiscoveryResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "scope",
        "status",
        "reason_codes",
        "profile_sha256",
        "snapshot_sha256",
        "core_absence_sha256",
        "issue_numbers",
        "process_targets"
      ],
      "properties": {
        "schema": {
          "const": "RBRIDGE_INSTALL_DISCOVERY_RESULT_V1"
        },
        "scope": {
          "const": "READONLY_PROBE_TARGETS_ONLY"
        },
        "status": {
          "const": "PASS"
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 4096
          },
          "maxItems": 0
        },
        "profile_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "snapshot_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "core_absence_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "issue_numbers": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "maxItems": 40000
        },
        "process_targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProcessProbeTarget"
          },
          "maxItems": 40000
        }
      }
    },
    "AuditError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "status",
        "reason_codes"
      ],
      "properties": {
        "schema": {
          "const": "RBRIDGE_INSTALL_AUDIT_ERROR_V1"
        },
        "status": {
          "const": "UNKNOWN"
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 4096
          },
          "maxItems": 100000
        }
      }
    }
  }
}
